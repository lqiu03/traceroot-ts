{
  "name": "@traceroot-ai/pi",
  "version": "0.1.0",
  "description": "Traceroot observability instrumentation for the Pi coding agent SDK",
  "keywords": [
    "traceroot",
    "pi",
    "pi-coding-agent",
    "observability",
    "opentelemetry"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "package.json"
  ],
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "tsx --test tests/*.test.ts",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/traceroot-ai/traceroot-ts.git"
  },
  "homepage": "https://traceroot.ai",
  "bugs": {
    "url": "https://github.com/traceroot-ai/traceroot-ts/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^1.30.1",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.57.2",
    "@opentelemetry/sdk-trace-base": "^1.30.1",
    "@opentelemetry/sdk-trace-node": "^1.30.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.79.0 <1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0"
  }
}
